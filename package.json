{
  "name": "bawkterm",
  "version": "0.1.2",
  "description": "Personal SSH, SFTP and keychain client",
  "main": "./out/main/index.js",
  "author": "CKH",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/juddisjudd/bawkterm.git"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "svelte-check --tsconfig ./tsconfig.web.json --threshold warning",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "test-server": "node scripts/test-server.cjs",
    "release": "node scripts/release.mjs",
    "icon": "node scripts/icon.mjs"
  },
  "dependencies": {
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@lucide/svelte": "1.48.0",
    "@resvg/resvg-js": "2.6.2",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.19.0",
    "@types/ssh2": "1.15.6",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "7.3.6"
  },
  "packageManager": "pnpm@11.25.0"
}
