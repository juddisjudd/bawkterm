+// security key public keys are only ever handed to an agent, which does the signing
+function parseSKPublic(data, type, comment) {
+  const start = data._pos || 0;
+  let pos = start;
+  if (type === 'sk-ecdsa-sha2-nistp256@openssh.com') {
+    if (readString(data, pos, true) !== 'nistp256')
+      return new Error('Malformed OpenSSH public key');
+    pos = data._pos;
+  }
+  const pub = readString(data, pos);
+  if (pub === undefined
+      || (type === 'sk-ssh-ed25519@openssh.com' && pub.length !== 32)) {
+    return new Error('Malformed OpenSSH public key');
+  }
+  if (readString(data, data._pos) === undefined)
+    return new Error('Malformed OpenSSH public key');
+  const fields = bufferSlice(data, start, data._pos);
+  const typeLen = Buffer.byteLength(type);
+  const pubSSH = Buffer.allocUnsafe(4 + typeLen + fields.length);
+  writeUInt32BE(pubSSH, typeLen, 0);
+  pubSSH.utf8Write(type, 4, typeLen);
+  pubSSH.set(fields, 4 + typeLen);
+  return new OpenSSH_Public(type, comment, null, pubSSH, null);
+}
